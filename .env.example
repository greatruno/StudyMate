# NODE_ENV: Application environment (development or production)
NODE_ENV="production"

# PORT: Server port (3000 required for AI Studio environment)
PORT=3000

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# SUPABASE & DATABASE CONFIGURATIONS
# ==========================================

# VITE_SUPABASE_URL: The API URL of your Supabase project (e.g., https://abcxyz.supabase.co).
# Exposed to client-side code via Vite (prefixed with VITE_).
VITE_SUPABASE_URL="https://your-supabase-project-id.supabase.co"

# VITE_SUPABASE_ANON_KEY: The public anonymous API key for your Supabase project.
# Exposed to client-side code for general requests respecting Row-Level Security (RLS).
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: The secret service role key for admin actions.
# Keep this STRICTLY server-side. NEVER expose this to the browser (do NOT prefix with VITE_).
# Used by backend workers to bypass RLS for system workflows.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# DATABASE_URL: Direct PostgreSQL connection string to your Supabase PostgreSQL instance.
# Format: postgres://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Keep this server-side only. Used for database migrations and raw queries.
DATABASE_URL="postgresql://postgres:password@host:port/database"

